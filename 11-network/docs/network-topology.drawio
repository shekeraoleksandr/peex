        <mxCell id="naclnote" value="&lt;b&gt;NACL — subnet layer, STATELESS&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#44546A&#x27;&gt;no 0.0.0.0/0 inbound rule here;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#44546A&#x27;&gt;ephemeral 1024-65535 must be opened&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#44546A&#x27;&gt;explicitly or every reply is dropped&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C9A227;fontSize=12;fontColor=#1A2B3C;strokeWidth=1.5;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="670" width="390" height="118" as="geometry"/></mxCell>
